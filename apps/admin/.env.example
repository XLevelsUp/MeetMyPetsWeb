# Supabase project connection for admin.meetmypets.app.
#
# Values live in the Supabase dashboard under Project Settings → API Keys
# (project ref: owfrnkafevdfzduuqnic).
#
# NEXT_PUBLIC_* vars are compiled into the browser bundle — they are public by
# definition. Only the URL and the *publishable* key may ever carry that
# prefix.

NEXT_PUBLIC_SUPABASE_URL=https://owfrnkafevdfzduuqnic.supabase.co

# Browser-safe key ("sb_publishable_..."). RLS is what protects data behind
# this key — it grants no privileged access by itself. If the project still
# uses legacy keys, this is the `anon` JWT instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret ("sb_secret_...", legacy: `service_role` JWT). Bypasses
# RLS entirely. NEVER prefix with NEXT_PUBLIC_, never import its client from
# code reachable by the browser — src/lib/supabase/admin.ts enforces this with
# `import "server-only"`.
SUPABASE_SECRET_KEY=

# Blog CMS → marketing site cache refresh.
#
# MARKETING_SITE_URL is the deployment the admin calls after a blog write
# (POST {url}/api/revalidate/) and the base of draft-preview links. Use the
# host that answers WITHOUT redirecting — production redirects the apex to
# www, and a redirect would drop the secret, so it is reported as a failure.
#   production: https://www.meetmypets.app
#   local:      http://localhost:3000
MARKETING_SITE_URL=

# Same value as apps/marketing's BLOG_REVALIDATE_SECRET. Server-only.
BLOG_REVALIDATE_SECRET=
