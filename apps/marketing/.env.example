# Copy to .env.local (or .env) and fill in. Without this the waitlist form
# renders in a clearly-marked "not connected" state rather than silently
# discarding signups.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, so
# changing this requires `npm run build` before it takes effect. A stale build
# keeps the old behaviour with no warning.

NEXT_PUBLIC_WAITLIST_ENDPOINT=https://script.google.com/macros/s/AKfy.../exec

# ---------------------------------------------------------------------------
# GOOGLE SHEET SETUP
#
# 1. Create a Google Sheet. Rename the first tab to exactly:  waitlist
#    Give it this header row (row 1, columns A-D):
#
#      Timestamp | Email | Phone | Source
#
# 2. Extensions > Apps Script. Replace the contents of Code.gs with the script
#    below, and Save.
#
# 3. Deploy > New deployment > type "Web app".
#      Execute as:      Me
#      Who has access:  Anyone
#    Deploy, authorise when prompted, and copy the /exec URL into
#    NEXT_PUBLIC_WAITLIST_ENDPOINT above.
#
#    "Anyone" is required — visitors are not signed in to Google. This makes
#    the endpoint public: anyone reading the site's JS bundle can find the URL
#    and append rows. The honeypot below filters naive bots; it does not stop
#    a determined person. That is the accepted trade for a serverless site.
#
# 4. Re-deploy after ANY script edit (Deploy > Manage deployments > edit >
#    New version). Saving alone does not update the live /exec URL.
#
# ---------------------------------------------------------------------------
# const SHEET_NAME = 'waitlist';
#
# function doPost(e) {
#   const out = (o) => ContentService.createTextOutput(JSON.stringify(o))
#     .setMimeType(ContentService.MimeType.JSON);
#
#   let data;
#   try { data = JSON.parse(e.postData.contents); }
#   catch (err) { return out({ ok: false, error: 'bad_json' }); }
#
#   // Honeypot: a hidden form field no human ever sees. Report success anyway
#   // so a bot cannot detect that it was filtered.
#   if (data.website) return out({ ok: true });
#
#   const email = String(data.email || '').trim().toLowerCase();
#   const phone = String(data.phone || '').trim();
#   if (!email && !phone) return out({ ok: false, error: 'empty' });
#
#   // Sheets has no unique constraint and appendRow is not atomic across
#   // concurrent executions, so serialise the read-then-append.
#   const lock = LockService.getScriptLock();
#   try { lock.waitLock(10000); } catch (err) { return out({ ok: false, error: 'busy' }); }
#
#   try {
#     const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NAME);
#     const last = sheet.getLastRow();
#     if (last > 1) {
#       const rows = sheet.getRange(2, 2, last - 1, 2).getValues();
#       for (const [e0, p0] of rows) {
#         if (email && String(e0).trim().toLowerCase() === email) return out({ ok: true });
#         if (phone && String(p0).trim() === phone) return out({ ok: true });
#       }
#     }
#     sheet.appendRow([new Date(), email, phone, data.source || 'waitlist']);
#     return out({ ok: true });
#   } finally {
#     lock.releaseLock();
#   }
# }
# ---------------------------------------------------------------------------
#
# NOTE ON CONTENT-TYPE
# The client posts with `Content-Type: text/plain;charset=utf-8`, not
# application/json. That keeps it a CORS "simple request" so the browser skips
# the preflight OPTIONS, which Apps Script cannot answer. If submissions start
# failing cross-origin, check that header first — see src/lib/waitlist.ts.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# INSTAGRAM REELS (optional)
#
# Read by scripts/fetch-reels.mjs at BUILD time only. Deliberately NOT
# NEXT_PUBLIC_* — a token in the client bundle is a token anyone can read and
# use. The browser only ever receives the generated src/data/reels.json.
#
# Missing or expired? The build still succeeds and the last committed
# reels.json keeps serving. An empty reels.json hides the section entirely.

INSTAGRAM_ACCESS_TOKEN=

# Optional. Unset, the script asks for `me/media` — the account the token
# itself belongs to, which is what you want in almost every case. Set this
# only to pull from a DIFFERENT account than the token's own.
INSTAGRAM_USER_ID=

# GETTING THESE
# 1. developers.facebook.com > Create App > type "Business".
# 2. Add the "Instagram Graph API" product.
# 3. Graph API Explorer: select the app, grant instagram_basic and
#    pages_show_list, then Generate Access Token.
# 4. Exchange the short-lived token (1 hour) for a long-lived one (60 days):
#      https://graph.instagram.com/access_token
#        ?grant_type=ig_exchange_token
#        &client_secret=APP_SECRET
#        &access_token=SHORT_LIVED_TOKEN
# 5. INSTAGRAM_USER_ID is the Instagram *Business* account id, not the handle.
#
# TOKEN EXPIRY — THE PART THAT BITES
# Long-lived tokens last 60 DAYS and must be refreshed before they lapse:
#   https://graph.instagram.com/refresh_access_token
#     ?grant_type=ig_refresh_token&access_token=CURRENT_TOKEN
# Refreshing returns a new 60-day token. Miss the window and the feed freezes
# at whatever reels.json was last committed — silently, since the build is
# designed not to fail. Put a calendar reminder at ~day 50.
