# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Un-anchored so the patterns apply inside each workspace (apps/*) as well as
# at the repo root — this file predates the npm-workspaces conversion.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Keep the documented Google Sheet / Apps Script setup template in version control.
!.env.example

# AI agent skills/config
.agents/
.claude/

# Instagram reels are fetched at build time and must NOT be committed: the
# script now fails closed, so a stale committed file would be the one thing
# that could put unverified reels on the live site. The seed below is created
# by the build; the import in src/lib/reels.ts needs the file to exist.
apps/marketing/src/data/reels.json
